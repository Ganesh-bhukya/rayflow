{
  "name": "rayflow",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered revenue recovery orchestration platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run build --workspaces"
  },
  "engines": {
    "node": ">=20"
  }
}